<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <title>Welcome to KalaCUBE</title>
  <!--[if mso]><style type="text/css">body,table,td,a{font-family:Arial,Helvetica,sans-serif !important;}</style><![endif]-->
  <style>@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');</style>
</head>
<body style="margin:0; padding:0; background-color:#FAF7F2; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; font-size:1px; line-height:1px; color:#FAF7F2;">Welcome to KalaCUBE — a world of art, in one cube.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#FAF7F2;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background-color:#FFFFFF; border-radius:16px; overflow:hidden; box-shadow:0 2px 12px rgba(11,31,82,0.06);">
          <!-- Header -->
          <tr>
            <td align="center" style="background-color:#FFFFFF; padding:32px 40px 20px 40px; border-bottom:1px solid #EFEAE1;">
              <img src="https://kalacube.com/brand/logo-primary.png" width="150" alt="KalaCUBE" style="display:block; width:150px; max-width:150px; height:auto; border:0;" />
            </td>
          </tr>
          <!-- Hero band -->
          <tr>
            <td align="center" style="background-color:#0B1F52; padding:34px 40px 32px 40px; font-family:'Poppins',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
              <p style="margin:0 0 8px 0; font-size:13px; letter-spacing:2px; text-transform:uppercase; color:#FFD200; font-weight:600;">Art Lives Here</p>
              <h1 style="margin:0; font-size:28px; line-height:1.25; font-weight:700; color:#FFFFFF;">Welcome, {{firstName}}!</h1>
            </td>
          </tr>
          <!-- Body -->
          <tr>
            <td style="padding:34px 40px 8px 40px; font-family:'Poppins',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
              <p style="margin:0 0 22px 0; font-size:16px; line-height:1.65; color:#3D3D46;">Thank you for joining KalaCUBE — a home for artists across Visual Art, Handicraft, and Performing Art. A world of art, in one cube. Here's what you can do next:</p>
            </td>
          </tr>
          <!-- Three dimensions, color-coded -->
          <tr>
            <td style="padding:0 40px 8px 40px; font-family:'Poppins',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td width="6" style="width:6px; background-color:#FF8A00; border-radius:3px;">&nbsp;</td>
                  <td style="padding:8px 0 8px 16px;">
                    <p style="margin:0 0 3px 0; font-size:16px; font-weight:600; color:#0B1F52;">Showcase</p>
                    <p style="margin:0; font-size:14px; line-height:1.55; color:#6B6B75;">Build your portfolio and share your work with the world.</p>
                  </td>
                </tr>
                <tr><td colspan="2" style="height:14px; line-height:14px; font-size:0;">&nbsp;</td></tr>
                <tr>
                  <td width="6" style="width:6px; background-color:#00A896; border-radius:3px;">&nbsp;</td>
                  <td style="padding:8px 0 8px 16px;">
                    <p style="margin:0 0 3px 0; font-size:16px; font-weight:600; color:#0B1F52;">Connect</p>
                    <p style="margin:0; font-size:14px; line-height:1.55; color:#6B6B75;">Meet fellow artists, curators, and art spaces across the community.</p>
                  </td>
                </tr>
                <tr><td colspan="2" style="height:14px; line-height:14px; font-size:0;">&nbsp;</td></tr>
                <tr>
                  <td width="6" style="width:6px; background-color:#D81B60; border-radius:3px;">&nbsp;</td>
                  <td style="padding:8px 0 8px 16px;">
                    <p style="margin:0 0 3px 0; font-size:16px; font-weight:600; color:#0B1F52;">Grow</p>
                    <p style="margin:0; font-size:14px; line-height:1.55; color:#6B6B75;">Discover opportunities and grow your practice with KalaCUBE.</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <!-- CTA -->
          <tr>
            <td align="center" style="padding:28px 40px 8px 40px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" bgcolor="#0B1F52" style="border-radius:10px;">
                    <a href="https://kalacube.com/explore" target="_blank" style="display:inline-block; padding:15px 44px; font-family:'Poppins',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:16px; font-weight:600; color:#FFFFFF; text-decoration:none; border-radius:10px;">Start Exploring</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:14px 40px 8px 40px; font-family:'Poppins',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
              <p style="margin:0; font-size:14px; line-height:1.6; color:#6B6B75;">Or head to your <a href="https://kalacube.com/dashboard" target="_blank" style="color:#202F9A; text-decoration:underline;">dashboard</a> to complete your profile.</p>
            </td>
          </tr>
          <!-- Footer -->
          <tr>
            <td style="padding:28px 40px 32px 40px; border-top:1px solid #EFEAE1; font-family:'Poppins',-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
              <p style="margin:0 0 6px 0; font-size:14px; font-weight:600; color:#0B1F52;">KalaCUBE <span style="color:#FFB800;">—</span> Art Lives Here.</p>
              <p style="margin:0 0 4px 0; font-size:12px; line-height:1.6; color:#9A9AA2;">A World of Art. In One Cube.</p>
              <p style="margin:0; font-size:12px; line-height:1.6; color:#9A9AA2;"><a href="https://kalacube.com" target="_blank" style="color:#202F9A; text-decoration:none;">kalacube.com</a></p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
