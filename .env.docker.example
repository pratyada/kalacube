# Copy to .env.docker (git-ignored) and fill in real values.
# Consumed by the `backend` service in docker-compose.yml.
# MONGO_URI / REDIS_HOST / REDIS_PORT / NODE_ENV / PORT are set by compose —
# do NOT put them here.

# App
CLIENT_URL=http://localhost:3000

# JWT — generate strong values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRATION=7d

# AWS S3 (required by config schema; placeholders are fine until uploads are used)
AWS_STORAGE_BUCKET=kalacube-assets
AWS_ACCESS_KEY=placeholder
AWS_SECRET_KEY=placeholder
AWS_REGION=ap-south-1

# Email / SMTP (required by config schema; placeholders are fine until email is used)
EMAIL_USERNAME=placeholder@example.com
EMAIL_PASSWORD=placeholder

# Password hashing
SALT_ROUNDS=10

# AWS Cognito (auth) — from AWS_SETUP_CHECKLIST.md "VALUES TO HAND BACK"
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_6Tz4OLn4d
COGNITO_APP_CLIENT_ID=

# OAuth - Google (optional; leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/oauth/google/callback

# OAuth - Facebook (optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:8000/api/auth/oauth/facebook/callback
